{
  "dashboard": {
    "title": "Supercomputer Monitoring Dashboard",
    "tags": ["supercomputer", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Network Metrics Collected",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(network_metrics_collected_total[1m])",
            "legendFormat": "Metrics Collected/sec",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Metrics/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 2,
        "title": "Nodes Monitored",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(nodes_monitored_total[1m])",
            "legendFormat": "Nodes/sec",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Nodes/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 3,
        "title": "Kafka Send Status",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(kafka_send_success_total[1m])",
            "legendFormat": "Kafka Send Success",
            "refId": "A"
          },
          {
            "expr": "rate(kafka_send_failures_total[1m])",
            "legendFormat": "Kafka Send Failures",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Events/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 4,
        "title": "Connection Recovery",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(connection_recovery_success_total[1m])",
            "legendFormat": "Recovery Success",
            "refId": "A"
          },
          {
            "expr": "rate(connection_recovery_failures_total[1m])",
            "legendFormat": "Recovery Failures",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Recoveries/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 5,
        "title": "High Load Processing",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(high_load_processed_total[1m])",
            "legendFormat": "Processed",
            "refId": "A"
          },
          {
            "expr": "rate(high_load_dropped_total[1m])",
            "legendFormat": "Dropped",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Packets/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 6,
        "title": "MPI Flood Detection",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "rate(mpi_flood_detected_total[1m])",
