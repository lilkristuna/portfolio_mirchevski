      {
        "id": 20,
        "title": "Service Health Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 40},
        "targets": [
          {
            "expr": "up{job=\"traffic-monitor-service\"}",
            "legendFormat": "Traffic Monitor",
            "refId": "A"
          },
          {
            "expr": "up{job=\"security-analyzer-service\"}",
            "legendFormat": "Security Analyzer",
            "refId": "B"
          },
          {
            "expr": "up{job=\"policy-manager-service\"}",
            "legendFormat": "Policy Manager",
            "refId": "C"
          },
          {
            "expr": "up{job=\"audit-logging-service\"}",
            "legendFormat": "Audit Logging",
