        "id": 7,
        "title": "False Positives & Normal Traffic",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(false_positive_total[1m])",
            "legendFormat": "False Positives",
            "refId": "A"
          },
          {
            "expr": "rate(normal_traffic_processed_total[1m])",
            "legendFormat": "Normal Traffic",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Events/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 8,
        "title": "ML Inference",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "rate(ml_inference_success_total[1m])",
