          {
            "expr": "rate(low_throughput_total[1m])",
            "legendFormat": "Low Throughput",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Events/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 19,
        "title": "Index Rotation",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 64},
        "targets": [
          {
            "expr": "rate(index_rotation_success_total[1m])",
            "legendFormat": "Rotation Success",
            "refId": "A"
          },
          {
            "expr": "rate(index_rotation_failures_total[1m])",
            "legendFormat": "Rotation Failures",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Rotations/sec"},
          {"format": "short"}
