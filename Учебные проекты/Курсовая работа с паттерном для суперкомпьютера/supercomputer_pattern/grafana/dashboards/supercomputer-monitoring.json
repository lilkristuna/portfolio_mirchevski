            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Inferences/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 9,
        "title": "Processing Timeout",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "rate(processing_timeout_total[1m])",
            "legendFormat": "Timeouts",
            "refId": "A"
          },
          {
            "expr": "rate(analysis_completed_total[1m])",
            "legendFormat": "Completed",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Events/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 10,
        "title": "Rate Limiting",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "rate(rate_limit_exceeded_total[1m])",
            "legendFormat": "Limit Exceeded",
            "refId": "A"
          },
          {
            "expr": "rate(rate_limit_ok_total[1m])",
            "legendFormat": "Within Limit",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Events/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"}
      },
      {
        "id": 11,
        "title": "Policies Loaded",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 40},
        "targets": [
          {
            "expr": "policies_loaded_total",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {},
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 1, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "title": "Policy Matching",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 40},
